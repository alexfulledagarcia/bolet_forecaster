# ==============================================================================
# Bolet Forecaster Catalunya - Environment Variables Template
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NOTE: .env is ignored by git and will never be committed to the public repo.
# ==============================================================================

# Meteocat API Key (Servei Meteorològic de Catalunya)
# Request a key at: https://apidocs.meteocat.gencat.cat/
# If left empty, Bolet Forecaster automatically falls back to Open-Meteo.
METEOCAT_API_KEY=

# Optional: Open-Meteo API Key (only needed if using commercial / high-volume tier)
OPEN_METEO_API_KEY=
